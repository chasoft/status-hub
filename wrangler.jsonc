{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "status-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  // Only the custom domains below are reachable. workers.dev and preview URLs stay off.
  "workers_dev": false,
  "preview_urls": false,
  // Replace example.com with your hostnames before the first deploy.
  "routes": [
    { "pattern": "status.example.com", "custom_domain": true },
    { "pattern": "mcp.example.com", "custom_domain": true }
  ],
  "vars": {
    // "production" or "staging". Tests set "test" so they can inject a JWKS.
    "ENVIRONMENT": "production",
    // AUTH_MODE: how the UI authenticates.
    // "access" verifies the Cloudflare Access JWT (Cf-Access-Jwt-Assertion). Unchanged default.
    // "token" serves /login. The operator enters a login token from scripts/gen-ui-login.mjs.
    //   D1 stores only the SHA-256 in ui_login_tokens. A signed HttpOnly Secure SameSite=Lax
    //   session cookie expires after AUTH_SESSION_TTL_SECONDS. POST /logout revokes that session.
    //   UI_ALLOWED_EMAILS, UI_MEMBER_EMAILS, and LEADERSHIP_AUTHORS still apply to the token's email.
    // "magic-link" is future work. A magic link has to be emailed, and this Worker does not
    //   include an email provider. The mode is rejected.
    "AUTH_MODE": "access",
    // AUTH_SESSION_TTL_SECONDS: session lifetime when AUTH_MODE=token. Default 43200 (12 hours), max 2592000.
    // Ignored for AUTH_MODE=access.
    "AUTH_SESSION_TTL_SECONDS": "43200",
    // AUTH_SESSION_SECRET: HMAC key for the token-mode session cookie. Required when AUTH_MODE=token.
    // Set with `wrangler secret put AUTH_SESSION_SECRET` (at least 16 characters). Do not commit the value.
    // Ignored for AUTH_MODE=access.
    // UI_HOST: hostname of the Kanban UI. Must match the UI custom domain above.
    "UI_HOST": "status.example.com",
    // MCP_HOST: hostname of the MCP server. Must match the MCP custom domain.
    // Serves /mcp and POST /attachment-uploads/:token. Any other path is 404.
    "MCP_HOST": "mcp.example.com",
    // ORG_NAME: text shown in the UI header.
    "ORG_NAME": "Status Hub",
    // MCP_SERVER_NAME: server name advertised to MCP clients.
    "MCP_SERVER_NAME": "status-hub",
    // ACCESS_TEAM_DOMAIN: Cloudflare Access team domain, without https://.
    // Example: your-team.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    // ACCESS_AUD: Access application AUD tag for the UI hostname. Empty denies every UI request.
    "ACCESS_AUD": "",
    // UI_ALLOWED_EMAILS: comma-separated emails allowed to open the UI, in addition to the Access policy.
    "UI_ALLOWED_EMAILS": "you@example.com",
    // OWNER_IDS: comma-separated ids treated as owners. They may be waiting_on, requested_by, and approved_by.
    // They do not have to exist in the members table.
    "OWNER_IDS": "",
    // APPROVER_IDS: comma-separated ids treated as approvers. Same privileges as owners.
    // Set these to the ids your deployment already uses. Owners and approvers do not have to be members.
    "APPROVER_IDS": "",
    // UI_MEMBER_EMAILS: comma-separated email=memberId pairs for UI sessions.
    // Emails not listed here map to a member id by their local-part when that id exists.
    "UI_MEMBER_EMAILS": "you@example.com=admin",
    // LEADERSHIP_AUTHORS: comma-separated email=Display Name pairs.
    // Only these sessions can post leadership feedback. The display name is what gets stored.
    // A note from one of these authors opens one LEADERSHIP_FEEDBACK alert on that task.
    "LEADERSHIP_AUTHORS": "you@example.com=Owner",
    // CURSOR_API_KEY: optional secret for live cloud-agent status on the task page.
    // Set with `wrangler secret put CURSOR_API_KEY`. Do not put the key in this file.
    // When set, a https://cursor.com/agents/bc-… link is loaded with
    // GET https://api.cursor.com/v0/agents/{id}. The key never reaches the browser.
    // When unset, the page shows the status stored by set_agent.
    // WEBHOOK_SECRET_KEY: optional secret that encrypts member webhook secrets in D1 (AES-GCM).
    // Set with `wrangler secret put WEBHOOK_SECRET_KEY`. Do not put the key in this file.
    // Member webhooks are set by an admin (MCP set_member_webhook or the Members page).
    // Optional alert overrides. Leave a variable unset to use the settings table.
    // Defaults (migration 0001, overridable in SQL): not_started_minutes=15, stale_hours=4,
    // stale_work_start_hour=8, stale_work_end_hour=22, blocked_hours=2, tz_offset_minutes=0 (UTC).
    // NOT_STARTED_MINUTES, STALE_HOURS, STALE_WORK_START_HOUR, STALE_WORK_END_HOUR,
    // BLOCKED_HOURS, TZ_OFFSET_MINUTES (minutes east of UTC).
    // ATTACHMENT_MAX_BYTES: optional max upload size in bytes. Default 10485760. Values above 26214400 are capped.
    // ATTACHMENT_ALLOWED_MIME: optional comma-separated MIME allowlist. When unset, png, jpeg, gif, webp,
    // avif, svg, pdf, text (plain, markdown, csv, tsv, yaml, xml, html, css, javascript, python, shell, sql),
    // json, video (mp4, webm, quicktime), and audio (mpeg, wav, ogg, mp4) are allowed.
  },
  // Optional R2 binding for task attachments. Leave it commented to hide file uploads.
  // The Worker reads binding name ATTACHMENTS. Downloads stay on the UI host; the bucket is not public.
  // Create it once, then uncomment:
  //   pnpm exec wrangler r2 bucket create status-hub-attachments
  // "r2_buckets": [
  //   { "binding": "ATTACHMENTS", "bucket_name": "status-hub-attachments" }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "status-hub",
      // Placeholder. `pnpm run setup` writes the real id into gitignored wrangler.local.jsonc.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true } },
  "env": {
    "staging": {
      "name": "status-hub-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "status-staging.example.com", "custom_domain": true },
        { "pattern": "mcp-staging.example.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        // Same AUTH_MODE values as production. magic-link is future work (no email provider).
        "AUTH_MODE": "access",
        "AUTH_SESSION_TTL_SECONDS": "43200",
        // AUTH_SESSION_SECRET: `wrangler secret put AUTH_SESSION_SECRET --env staging`. Do not commit it.
        "UI_HOST": "status-staging.example.com",
        "MCP_HOST": "mcp-staging.example.com",
        "ORG_NAME": "Status Hub",
        "MCP_SERVER_NAME": "status-hub",
        "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "UI_ALLOWED_EMAILS": "you@example.com",
        "OWNER_IDS": "",
        "APPROVER_IDS": "",
        "UI_MEMBER_EMAILS": "you@example.com=admin",
        "LEADERSHIP_AUTHORS": "you@example.com=Owner"
        // ATTACHMENT_MAX_BYTES and ATTACHMENT_ALLOWED_MIME: same optional overrides as production.
      },
      // Optional, separate from production. Uncomment after creating the staging bucket:
      //   pnpm exec wrangler r2 bucket create status-hub-attachments-staging
      // "r2_buckets": [
      //   { "binding": "ATTACHMENTS", "bucket_name": "status-hub-attachments-staging" }
      // ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "status-hub-staging",
          // Placeholder. Setup writes the real staging id into wrangler.local.jsonc.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
}
