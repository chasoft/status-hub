{
  "name": "status-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Chasoft Labs",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.node.config.mjs",
    "db:migrate:local": "wrangler d1 migrations apply status-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply status-hub --remote --config wrangler.local.jsonc",
    "token": "node scripts/gen-token.mjs",
    "ui-login": "node scripts/gen-ui-login.mjs",
    "db:migrate:staging": "wrangler d1 migrations apply status-hub-staging --env staging --remote --config wrangler.local.jsonc",
    "deploy:staging": "node scripts/deploy.mjs --env staging"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6"
}
